---
import { Image } from 'astro:assets';

import { formatDuration } from '../lib/recipes/domain';
import type { ResolvedRecipe } from '../lib/recipes/types';

interface Props {
  resolved: ResolvedRecipe;
  component?: boolean;
}

const { resolved, component = false } = Astro.props;
---

<section
  class:list={['instructions', { component }]}
  data-instruction-source={resolved.recipe.id}
>
  <h2>{component ? 'Étapes' : 'Préparation'}</h2>
  {
    resolved.recipe.data.instructionSections.map((section) => (
      <div class="section">
        {section.title && section.title !== 'Préparation' && (
          <h3>{section.title}</h3>
        )}
        <ol>
          {section.steps.map((step) => {
            return (
              <li>
                <input
                  type="checkbox"
                  aria-label="Marquer cette étape comme terminée"
                />
                <div class="step-content">
                  <p>{step.text}</p>
                  {step.timerMinutes !== undefined && (
                    <span class="timer" data-timer-minutes={step.timerMinutes}>
                      Durée : {formatDuration(step.timerMinutes)}
                    </span>
                  )}
                  {step.image && (
                    <figure>
                      <Image
                        src={step.image.src}
                        alt={step.image.alt}
                        loading="lazy"
                      />
                      {step.image.caption && (
                        <figcaption>{step.image.caption}</figcaption>
                      )}
                    </figure>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    ))
  }
</section>

<style>
  h2 {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 1rem;
  }

  h3 {
    margin: 1.5rem 0 0.5rem;
    color: var(--color-accent);
    font-size: 1rem;
  }

  ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    display: grid;
    align-items: start;
    gap: 0.55rem;
    grid-template-columns: auto minmax(0, 1fr);
    padding-block: 0.45rem;
    line-height: 1.4;
  }

  input {
    width: 0.9rem;
    height: 0.9rem;
    margin: 0.22rem 0 0;
  }

  .step-content p {
    margin: 0;
  }

  .timer {
    display: inline-block;
    margin-top: 0.4rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  figure {
    margin: 1.2rem 0 0;
  }

  figure :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 0.88rem;
  }
</style>
