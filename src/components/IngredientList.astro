---
import { formatAmount, scaleAmount } from '../lib/recipes/domain';
import type { ResolvedRecipe } from '../lib/recipes/types';

interface Props {
  resolved: ResolvedRecipe;
  component?: boolean;
}

const { resolved, component = false } = Astro.props;
---

<section
  class:list={['ingredients', { component }]}
  data-ingredient-source={resolved.recipe.id}
>
  <h2>{component ? 'Ingrédients' : 'Ingrédients'}</h2>
  {
    resolved.recipe.data.ingredientGroups.map((group) => (
      <div class="group">
        {group.title && <h3>{group.title}</h3>}
        <ul>
          {group.ingredients.map((ingredient) => {
            const effectiveAmount = scaleAmount(
              ingredient.amount,
              resolved.factor,
              ingredient.scalable,
            );
            const scalable =
              ingredient.scalable && effectiveAmount.type !== 'qualitative';
            return (
              <li data-ingredient-name={ingredient.name}>
                <span class="amount-wrap">
                  {ingredient.approximate && <span>environ </span>}
                  <span
                    class="amount"
                    data-base-amount={
                      scalable ? JSON.stringify(effectiveAmount) : undefined
                    }
                  >
                    {formatAmount(effectiveAmount)}
                  </span>
                </span>{' '}
                <span class="name">{ingredient.name}</span>
                {ingredient.note && (
                  <span class="note"> — {ingredient.note}</span>
                )}
                {ingredient.optional && (
                  <span class="optional"> facultatif</span>
                )}
                {ingredient.alternatives?.map((alternative) => {
                  const alternativeAmount = scaleAmount(
                    alternative.amount,
                    resolved.factor,
                    ingredient.scalable,
                  );
                  const alternativeScales =
                    ingredient.scalable &&
                    alternativeAmount.type !== 'qualitative';
                  return (
                    <span class="alternative">
                      ou{' '}
                      <span
                        class="amount"
                        data-base-amount={
                          alternativeScales
                            ? JSON.stringify(alternativeAmount)
                            : undefined
                        }
                      >
                        {formatAmount(alternativeAmount)}
                      </span>{' '}
                      {alternative.name}
                      {alternative.note && (
                        <span class="note"> — {alternative.note}</span>
                      )}
                    </span>
                  );
                })}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .ingredients > h2 {
    margin: 0 0 1.25rem;
  }

  .ingredients.component > h2 {
    font-size: clamp(1.55rem, 3vw, 2.15rem);
  }

  .group + .group {
    margin-top: 1.75rem;
  }

  h3 {
    margin: 0 0 0.65rem;
    color: var(--color-herb);
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 850;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  li {
    padding-block: 0.65rem;
    border-bottom: 1px solid rgb(223 212 199 / 72%);
    line-height: 1.4;
  }

  .amount-wrap,
  .amount {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
  }

  .name {
    font-weight: 600;
  }

  .note,
  .alternative {
    color: var(--color-muted);
    font-size: 0.92em;
  }

  .alternative {
    display: block;
    margin-top: 0.25rem;
    padding-left: 1rem;
  }

  .optional {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.08rem 0.45rem;
    border-radius: 10rem;
    background: #edf3eb;
    color: var(--color-herb);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }
</style>
