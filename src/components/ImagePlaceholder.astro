---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div
  class:list={['placeholder', { compact }]}
  data-image-placeholder
  role="img"
  aria-label="Aucune photo disponible"
>
</div>

<style>
  .placeholder {
    display: grid;
    width: 100%;
    min-height: 26rem;
    place-items: center;
    background: var(--color-accent);
    color: rgb(255 255 255 / 80%);
  }

  .compact {
    height: 100%;
    min-height: 100%;
  }
</style>
