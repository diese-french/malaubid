---
import { Image } from 'astro:assets';

import { getCategoryLabel } from '../lib/recipes/categories';
import type { RecipeEntry } from '../lib/recipes/service';
import HeroPlaceholder from './HeroPlaceholder.astro';

interface Props {
  recipe: RecipeEntry;
  eager?: boolean;
}

const { recipe, eager = false } = Astro.props;
---

<article class="card" data-recipe-card>
  <a class="card-link" href={`/recettes/${recipe.id}/`}>
    <span class="visual" aria-hidden="true">
      {
        recipe.data.hero ? (
          <Image
            src={recipe.data.hero.src}
            alt=""
            width={640}
            loading={eager ? 'eager' : 'lazy'}
          />
        ) : (
          <HeroPlaceholder compact />
        )
      }
    </span>
    <h2 data-recipe-title>{recipe.data.title}</h2>
    <span class="visually-hidden">
      {getCategoryLabel(recipe.data.category)}. {recipe.data.description}
    </span>
  </a>
</article>

<style>
  .card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 2 / 1;
    background: var(--color-accent);
  }

  .card-link {
    position: absolute;
    inset: 0;
    display: block;
    color: white;
    text-decoration: none;
  }

  .visual {
    position: absolute;
    inset: 0;
    transition: opacity 180ms ease;
  }

  .visual::after {
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(transparent, rgb(0 0 0 / 42%));
    content: '';
  }

  .visual :global(img),
  .visual :global([data-hero-placeholder]) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-link:hover,
  .card-link:focus-visible {
    color: white;
  }

  .card-link:hover .visual,
  .card-link:focus-visible .visual {
    opacity: 0.22;
  }

  h2 {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    left: 0;
    margin: 0;
    padding: 1rem;
    color: white;
    font-size: clamp(1.25rem, 2.1vw, 2rem);
    line-height: 1.05;
    text-shadow: 0 1px 0.25rem rgb(0 0 0 / 45%);
  }
</style>
