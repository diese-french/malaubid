---
import BrandMark from '../components/BrandMark.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | undefined;
  image?: string | undefined;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image,
} = Astro.props;
const pageTitle = title === 'Malaubid' ? title : `${title} — Malaubid`;
const canonicalUrl = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3d9970" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Karla:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Malaubid, accueil">
        <BrandMark />
      </a>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a href="/">Recettes</a>
        <a href="/a-propos/">À propos</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 4.5rem;
    padding: 0.6rem 0.8rem;
    background: white;
    color: var(--color-ink);
    transform: translateY(-180%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    height: 0;
  }

  .brand {
    position: fixed;
    z-index: 20;
    top: 0;
    left: 0;
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0.5rem;
    place-items: center;
    background: var(--color-accent);
    color: white;
  }

  .brand:hover {
    background: var(--color-accent-dark);
    color: white;
  }

  .brand :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
  }

  .site-footer {
    margin-top: 4rem;
    padding-block: 3rem;
    background: rgb(0 0 0 / 6.25%);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
  }

  .footer-inner a {
    color: var(--color-ink);
  }

  @media (max-width: 32rem) {
    .footer-inner {
      align-items: center;
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
