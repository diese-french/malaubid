---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import HeroPlaceholder from '../../components/HeroPlaceholder.astro';
import IngredientList from '../../components/IngredientList.astro';
import InstructionList from '../../components/InstructionList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryLabel } from '../../lib/recipes/categories';
import {
  durationToIso,
  formatDuration,
  formatYield,
  resolveRecipeTree,
} from '../../lib/recipes/domain';
import { serializeRecipeJsonLd } from '../../lib/recipes/jsonld';
import {
  createRecipeIndex,
  getAllRecipeEntries,
  getRoutableRecipes,
  toRecipeSource,
  type RecipeEntry,
} from '../../lib/recipes/service';
import type { ResolvedRecipe } from '../../lib/recipes/types';

interface Props {
  entry: RecipeEntry;
  entries: RecipeEntry[];
}

export async function getStaticPaths() {
  const entries = await getAllRecipeEntries();
  return getRoutableRecipes(entries, import.meta.env.DEV).map((entry) => ({
    params: { id: entry.id },
    props: { entry, entries },
  }));
}

const { entry, entries } = Astro.props;
const recipe = toRecipeSource(entry);
const recipeIndex = createRecipeIndex(entries);
const tree = resolveRecipeTree(recipe, recipeIndex);

function flattenTree(node: ResolvedRecipe): ResolvedRecipe[] {
  return [node, ...node.components.flatMap(flattenTree)];
}

const { Content: RootContent } = await render(entry);
const rootBody = entry.body?.trim();
const rootHasBody = Boolean(
  rootBody && rootBody !== entry.data.description?.trim(),
);
const componentContents = flattenTree(tree).slice(1);
const canonicalPath = `/recettes/${entry.id}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const heroUrl = entry.data.hero
  ? new URL(entry.data.hero.src.src, Astro.site).href
  : undefined;
const jsonLd = serializeRecipeJsonLd(recipe, recipeIndex, {
  canonicalUrl,
  ...(heroUrl ? { imageUrl: heroUrl } : {}),
});
const jsonLdText = JSON.stringify(jsonLd).replaceAll('<', '\\u003c');
const durations = [
  ['Préparation', entry.data.durations.prepMinutes],
  ['Cuisson', entry.data.durations.cookMinutes],
  ['Repos', entry.data.durations.restMinutes],
  ['Total', entry.data.durations.totalMinutes],
] as const;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description ?? `Préparation ${entry.data.title}.`}
  canonicalPath={canonicalPath}
  image={heroUrl}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={jsonLdText}
    is:inline
  />

  <article
    class="recipe"
    data-recipe-scaler
    data-base-yield={entry.data.yield.quantity}
  >
    <header class="recipe-header shell">
      <figure class="hero-media">
        {
          entry.data.hero ? (
            <Image
              src={entry.data.hero.src}
              alt={entry.data.hero.alt}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <HeroPlaceholder />
          )
        }
        {
          entry.data.hero?.credit && (
            <figcaption>
              Crédit photo :{' '}
              <a href={entry.data.hero.credit} rel="external">
                source
              </a>
            </figcaption>
          )
        }
      </figure>
      <div class="title-block">
        {
          entry.data.visibility === 'draft' && (
            <p class="draft-banner">
              Brouillon · visible uniquement en développement
            </p>
          )
        }
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p class="lede">{entry.data.description}</p>}
        <p class="byline">
          {getCategoryLabel(entry.data.category)} · {entry.data.author}
        </p>
      </div>
      <dl class="metadata" aria-label="Durées">
        {
          durations.map(([label, minutes]) =>
            minutes !== undefined ? (
              <div>
                <dt>{label}</dt>
                <dd>
                  <time datetime={durationToIso(minutes)}>
                    {formatDuration(minutes)}
                  </time>
                </dd>
              </div>
            ) : null,
          )
        }
      </dl>
    </header>

    <div class="recipe-content shell">
      <div class="recipe-grid">
        <aside>
          {
            tree.components.length > 0 && (
              <section class="component-summary">
                <h2>Étapes</h2>
                <ul>
                  {tree.components.map((component) => (
                    <li>{component.recipe.data.title}</li>
                  ))}
                </ul>
              </section>
            )
          }
          <section class="scaler" aria-labelledby="yield-title">
            <h2 id="yield-title">Quantités</h2>
            <div class="yield-control">
              <label class="visually-hidden" for="target-yield">
                Quantité souhaitée
              </label>
              <div class="input-row">
                <input
                  id="target-yield"
                  data-yield-input
                  data-yield-label={entry.data.yield.label}
                  type="number"
                  min="0.01"
                  step="0.5"
                  inputmode="decimal"
                  value={entry.data.yield.quantity}
                />
                <span>{entry.data.yield.label}</span>
              </div>
              <p class="base-yield">
                Base&nbsp;: {
                  formatYield(entry.data.yield.quantity, entry.data.yield.label)
                }
              </p>
              <button type="button" data-yield-reset>Réinitialiser</button>
              <p class="status" data-yield-status aria-live="polite"></p>
            </div>
          </section>
          {
            entry.data.ingredientGroups.length > 0 && (
              <IngredientList resolved={tree} />
            )
          }
          {
            entry.data.equipment && entry.data.equipment.length > 0 && (
              <section class="equipment">
                <h2>Matériel</h2>
                <ul>
                  {entry.data.equipment.map((item) => (
                    <li>
                      {item.quantity && <strong>{item.quantity} </strong>}
                      {item.name}
                      {item.note && <span> — {item.note}</span>}
                      {item.optional && <span> (facultatif)</span>}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </aside>
        <div>
          <InstructionList resolved={tree} />
          {
            rootHasBody && (
              <section class="notes">
                <h2>Notes</h2>
                <div class="prose">
                  <RootContent />
                </div>
              </section>
            )
          }
        </div>
      </div>

      {
        componentContents.length > 0 && (
          <>
            <div class="component-divider" aria-hidden="true">
              ↓ Recette par étapes ↓
            </div>
            <section class="components" aria-labelledby="components-title">
              <h2 class="visually-hidden" id="components-title">
                Recette par étapes
              </h2>
              <div class="component-stack">
                {componentContents.map((resolved) => (
                  <article
                    class="component"
                    data-component-id={resolved.recipe.id}
                  >
                    <header>
                      <h3>{resolved.recipe.data.title}</h3>
                    </header>
                    <div class="component-grid">
                      <IngredientList resolved={resolved} component />
                      <InstructionList resolved={resolved} component />
                    </div>
                  </article>
                ))}
              </div>
            </section>
          </>
        )
      }
    </div>
  </article>
</BaseLayout>

<script>
  import '../../scripts/quantity-scaler';
</script>

<style>
  .recipe-header {
    padding-top: 0.75rem;
  }

  .title-block {
    max-width: 42rem;
    margin: 2rem auto 0;
    text-align: center;
  }

  .title-block h1 {
    margin-block: 0 1rem;
  }

  .draft-banner {
    padding: 0.6rem 0.8rem;
    background: #fff0b8;
    color: #624b00;
    font-weight: 700;
  }

  .hero-media {
    margin: 0;
    background: var(--color-accent);
  }

  .hero-media :global(img) {
    width: 100%;
    height: auto;
  }

  .hero-media figcaption {
    padding-top: 0.35rem;
    color: var(--color-muted);
    font-size: 0.8rem;
    text-align: right;
  }

  .lede {
    margin-inline: auto;
  }

  .byline {
    margin-bottom: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    margin: 1.5rem auto 0;
  }

  .metadata div {
    display: flex;
    gap: 0.35rem;
  }

  .metadata dt {
    color: var(--color-muted);
  }

  .metadata dt::after {
    content: '\00a0:';
  }

  .metadata dd {
    margin: 0;
  }

  .recipe-content {
    margin-top: 3rem;
  }

  .recipe-grid {
    display: grid;
    align-items: start;
    gap: 4rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .component-summary,
  .scaler {
    margin-bottom: 1.5rem;
  }

  .component-summary h2,
  .scaler h2,
  .equipment h2,
  .notes h2 {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 1rem;
  }

  .component-summary ul,
  .equipment ul {
    padding-left: 1.2rem;
    margin-block: 0;
  }

  .input-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .input-row input {
    width: 4.5rem;
    height: 2.25rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid #aaa;
    background: white;
    color: var(--color-ink);
    font-weight: 700;
  }

  .input-row input[aria-invalid='true'] {
    border-color: #c00;
  }

  .base-yield {
    margin: 0.35rem 0 0;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  button {
    padding: 0;
    border: 0;
    margin-top: 0.35rem;
    background: transparent;
    color: var(--color-accent-dark);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .status {
    min-height: 1.3em;
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  .equipment,
  .notes {
    margin-top: 2rem;
  }

  .prose :global(p:first-child) {
    margin-top: 0;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .component-divider {
    padding: 0.8rem;
    margin-block: 3rem;
    background: rgb(0 0 0 / 12.5%);
    text-align: center;
  }

  .component-stack {
    display: grid;
    gap: 3rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .component h3 {
    margin: 0 0 1.5rem;
    color: var(--color-accent);
    font-size: 1rem;
    text-align: center;
  }

  .component-grid {
    display: grid;
    gap: 2rem;
  }

  @media (max-width: 40rem) {
    .recipe-grid {
      grid-template-columns: 1fr;
    }

    .title-block {
      margin-top: 1.5rem;
    }

    .recipe-content {
      margin-top: 2rem;
    }

    .recipe-grid {
      gap: 2.5rem;
    }
  }
</style>
