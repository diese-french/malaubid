---
import { Image } from 'astro:assets';
import { render } from 'astro:content';

import HeroPlaceholder from '../../components/HeroPlaceholder.astro';
import IngredientList from '../../components/IngredientList.astro';
import InstructionList from '../../components/InstructionList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryLabel } from '../../lib/recipes/categories';
import {
  durationToIso,
  formatDuration,
  formatYield,
  resolveRecipeTree,
} from '../../lib/recipes/domain';
import { serializeRecipeJsonLd } from '../../lib/recipes/jsonld';
import {
  createRecipeIndex,
  getAllRecipeEntries,
  getRoutableRecipes,
  toRecipeSource,
  type RecipeEntry,
} from '../../lib/recipes/service';
import type { ResolvedRecipe } from '../../lib/recipes/types';

interface Props {
  entry: RecipeEntry;
  entries: RecipeEntry[];
}

export async function getStaticPaths() {
  const entries = await getAllRecipeEntries();
  return getRoutableRecipes(entries, import.meta.env.DEV).map((entry) => ({
    params: { id: entry.id },
    props: { entry, entries },
  }));
}

const { entry, entries } = Astro.props;
const recipe = toRecipeSource(entry);
const recipeIndex = createRecipeIndex(entries);
const tree = resolveRecipeTree(recipe, recipeIndex);

function flattenTree(node: ResolvedRecipe): ResolvedRecipe[] {
  return [node, ...node.components.flatMap(flattenTree)];
}

const resolvedEntries = await Promise.all(
  flattenTree(tree).map(async (resolved) => {
    const contentEntry = entries.find(({ id }) => id === resolved.recipe.id);
    if (!contentEntry) {
      throw new Error(
        `Missing content entry for resolved recipe "${resolved.recipe.id}".`,
      );
    }
    const { Content } = await render(contentEntry);
    return { resolved, Content, hasBody: Boolean(contentEntry.body?.trim()) };
  }),
);
const rootContent = resolvedEntries[0];
if (!rootContent)
  throw new Error(`Recipe "${entry.id}" did not resolve to a root entry.`);
const RootContent = rootContent.Content;
const componentContents = resolvedEntries.slice(1);
const canonicalPath = `/recettes/${entry.id}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const heroUrl = entry.data.hero
  ? new URL(entry.data.hero.src.src, Astro.site).href
  : undefined;
const jsonLd = serializeRecipeJsonLd(recipe, recipeIndex, {
  canonicalUrl,
  ...(heroUrl ? { imageUrl: heroUrl } : {}),
});
const jsonLdText = JSON.stringify(jsonLd).replaceAll('<', '\\u003c');
const durations = [
  ['Préparation', entry.data.durations.prepMinutes],
  ['Cuisson', entry.data.durations.cookMinutes],
  ['Repos', entry.data.durations.restMinutes],
  ['Total', entry.data.durations.totalMinutes],
] as const;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description ?? `Préparation ${entry.data.title}.`}
  canonicalPath={canonicalPath}
  image={heroUrl}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={jsonLdText}
    is:inline
  />

  <article
    class="recipe"
    data-recipe-scaler
    data-base-yield={entry.data.yield.quantity}
  >
    <header class="recipe-header shell">
      <div class="title-block">
        {
          entry.data.visibility === 'draft' && (
            <p class="draft-banner">
              Brouillon · visible uniquement en développement
            </p>
          )
        }
        <p class="eyebrow">{getCategoryLabel(entry.data.category)}</p>
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p class="lede">{entry.data.description}</p>}
        <p class="author">
          Une recette de <strong>{entry.data.author}</strong>
        </p>
      </div>
      <figure class="hero-media">
        {
          entry.data.hero ? (
            <Image
              src={entry.data.hero.src}
              alt={entry.data.hero.alt}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <HeroPlaceholder />
          )
        }
        {
          entry.data.hero?.credit && (
            <figcaption>
              Crédit photo :{' '}
              <a href={entry.data.hero.credit} rel="external">
                source
              </a>
            </figcaption>
          )
        }
      </figure>
    </header>

    <div class="recipe-content shell">
      <section class="scaler surface" aria-labelledby="yield-title">
        <div>
          <p class="eyebrow">Adapter la recette</p>
          <h2 id="yield-title">Pour combien&nbsp;?</h2>
          <p>
            Base : {
              formatYield(entry.data.yield.quantity, entry.data.yield.label)
            }
          </p>
        </div>
        <div class="yield-control">
          <label for="target-yield">Quantité souhaitée</label>
          <div class="input-row">
            <input
              id="target-yield"
              data-yield-input
              data-yield-label={entry.data.yield.label}
              type="number"
              min="0.01"
              step="0.5"
              inputmode="decimal"
              value={entry.data.yield.quantity}
            />
            <span>{entry.data.yield.label}</span>
          </div>
          <button type="button" data-yield-reset
            >Revenir à la recette d’origine</button
          >
          <p class="status" data-yield-status aria-live="polite"></p>
        </div>
      </section>

      <dl class="metadata" aria-label="Informations sur la recette">
        {
          durations.map(([label, minutes]) =>
            minutes !== undefined ? (
              <div>
                <dt>{label}</dt>
                <dd>
                  <time datetime={durationToIso(minutes)}>
                    {formatDuration(minutes)}
                  </time>
                </dd>
              </div>
            ) : null,
          )
        }
      </dl>

      <div class="recipe-grid">
        <aside>
          <IngredientList resolved={tree} />
          {
            entry.data.equipment && entry.data.equipment.length > 0 && (
              <section class="equipment">
                <h2>Matériel</h2>
                <ul>
                  {entry.data.equipment.map((item) => (
                    <li>
                      {item.quantity && <strong>{item.quantity} </strong>}
                      {item.name}
                      {item.note && <span> — {item.note}</span>}
                      {item.optional && <span> (facultatif)</span>}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </aside>
        <div>
          <InstructionList resolved={tree} />
          {
            rootContent.hasBody && (
              <section class="notes surface">
                <h2>Notes</h2>
                <div class="prose">
                  <RootContent />
                </div>
              </section>
            )
          }
        </div>
      </div>

      {
        componentContents.length > 0 && (
          <section class="components" aria-labelledby="components-title">
            <p class="eyebrow">Préparations liées</p>
            <h2 id="components-title">À préparer aussi</h2>
            <div class="component-stack">
              {componentContents.map(({ resolved, Content, hasBody }) => (
                <article
                  class="component surface"
                  data-component-id={resolved.recipe.id}
                >
                  <header>
                    <p class="component-factor">
                      Facteur de base · {resolved.factor}
                    </p>
                    <h3>{resolved.recipe.data.title}</h3>
                  </header>
                  <div class="component-grid">
                    <IngredientList resolved={resolved} component />
                    <InstructionList resolved={resolved} component />
                  </div>
                  {hasBody && (
                    <div class="component-notes prose">
                      <Content />
                    </div>
                  )}
                </article>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<script>
  import '../../scripts/quantity-scaler';
</script>

<style>
  .recipe-header {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 0.85fr) minmax(20rem, 1.15fr);
    padding-block: clamp(3rem, 8vw, 7rem);
  }

  .title-block h1 {
    margin-block: 0 1.25rem;
  }

  .author {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }

  .draft-banner {
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-small);
    background: #fff0b8;
    color: #624b00;
    font-weight: 750;
  }

  .hero-media {
    overflow: hidden;
    margin: 0;
    border-radius: var(--radius-large);
    background: #eadbca;
    box-shadow: var(--shadow-soft);
  }

  .hero-media :global(img) {
    width: 100%;
    max-height: 42rem;
    object-fit: cover;
  }

  .hero-media figcaption {
    padding: 0.6rem 1rem;
    background: white;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .recipe-content {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
  }

  .scaler {
    display: grid;
    align-items: center;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.8fr);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .scaler h2,
  .scaler p {
    margin-block: 0;
  }

  .scaler > div:first-child > p:last-child {
    margin-top: 0.6rem;
    color: var(--color-muted);
  }

  .yield-control label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.82rem;
    font-weight: 800;
  }

  .input-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  input {
    width: min(9rem, 45vw);
    padding: 0.65rem 0.8rem;
    border: 2px solid var(--color-line);
    border-radius: var(--radius-small);
    background: white;
    color: var(--color-ink);
    font-size: 1.2rem;
    font-weight: 800;
  }

  input[aria-invalid='true'] {
    border-color: var(--color-accent);
  }

  button {
    padding: 0;
    border: 0;
    margin-top: 0.75rem;
    background: transparent;
    color: var(--color-accent-dark);
    cursor: pointer;
    font-size: 0.84rem;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .status {
    min-height: 1.3em;
    margin: 0.35rem 0 0;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .metadata {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    overflow: hidden;
    padding: 1px;
    margin: 0;
    border-radius: var(--radius-medium);
    background: var(--color-line);
  }

  .metadata div {
    padding: 1rem;
    background: var(--color-paper);
  }

  .metadata dt {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .metadata dd {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .recipe-grid {
    display: grid;
    align-items: start;
    gap: clamp(3rem, 8vw, 8rem);
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
  }

  .equipment {
    margin-top: 3rem;
  }

  .equipment h2 {
    font-size: 1.8rem;
  }

  .equipment ul {
    padding-left: 1.2rem;
  }

  .notes {
    margin-top: 3rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .notes h2 {
    margin-top: 0;
    font-size: 1.7rem;
  }

  .prose :global(p:first-child) {
    margin-top: 0;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .components {
    padding-top: 1rem;
  }

  .components > h2 {
    margin-top: 0;
  }

  .component-stack {
    display: grid;
    gap: 2rem;
  }

  .component {
    padding: clamp(1.4rem, 4vw, 3rem);
  }

  .component > header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .component h3 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .component-factor {
    margin: 0 0 0.3rem;
    color: var(--color-herb);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .component-grid {
    display: grid;
    gap: clamp(2rem, 7vw, 6rem);
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    padding-top: 2rem;
  }

  .component-notes {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
    margin-top: 2rem;
    color: var(--color-muted);
  }

  @media (max-width: 52rem) {
    .recipe-header,
    .scaler,
    .recipe-grid,
    .component-grid {
      grid-template-columns: 1fr;
    }

    .metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-media {
      order: -1;
    }
  }

  @media (max-width: 32rem) {
    .metadata {
      grid-template-columns: 1fr;
    }
  }
</style>
