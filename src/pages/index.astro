---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { buildRecipeSearchText } from '../lib/recipes/search';
import {
  createRecipeIndex,
  getAllRecipeEntries,
  getListedRecipes,
  toRecipeSource,
} from '../lib/recipes/service';

const entries = await getAllRecipeEntries();
const recipes = getListedRecipes(entries);
const recipeIndex = createRecipeIndex(entries);
---

<BaseLayout title="Malaubid" description="Malaubid, un site de recettes.">
  <section class="search" role="search">
    <label class="visually-hidden" for="recipe-search">
      Rechercher une recette
    </label>
    <input
      id="recipe-search"
      data-recipe-search
      type="search"
      placeholder="Rechercher une recette"
      autocomplete="off"
      aria-controls="recipe-grid"
    />
    <svg class="search-icon" viewBox="0 0 32 32" aria-hidden="true">
      <path
        d="M12 0a12 12 0 1 0 6.5 22.1L28 32l4-4-9.9-9.5A12 12 0 0 0 12 0Zm0 4a8 8 0 1 1 0 16 8 8 0 0 1 0-16Z"
      ></path>
    </svg>
    <p class="search-status" data-search-status aria-live="polite"></p>
  </section>
  <section class="recipes" aria-labelledby="recipes-title">
    <h1 class="visually-hidden" id="recipes-title">Recettes</h1>
    <div class="recipe-grid" id="recipe-grid">
      {
        recipes.map((recipe, index) => (
          <RecipeCard
            recipe={recipe}
            searchText={buildRecipeSearchText(
              toRecipeSource(recipe),
              recipeIndex,
            )}
            eager={index < 6}
          />
        ))
      }
    </div>
  </section>
  <div class="github-link-section">
    <a class="github-link" href="https://github.com/diese-french/malaubid">
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <path
          d="M0 18 C0 12 3 10 3 9 C2.5 7 2.5 4 3 3 C6 3 9 5 10 6 C12 5 14 5 16 5 C18 5 20 5 22 6 C23 5 26 3 29 3 C29.5 4 29.5 7 29 9 C29 10 32 12 32 18 C32 25 30 30 16 30 C2 30 0 25 0 18 M3 20 C3 24 4 28 16 28 C28 28 29 24 29 20 C29 16 28 14 16 14 C4 14 3 16 3 20 M8 21 A1.5 2.5 0 0 0 13 21 A1.5 2.5 0 0 0 8 21 M24 21 A1.5 2.5 0 0 0 19 21 A1.5 2.5 0 0 0 24 21 z"
        ></path>
      </svg>
      View on GitHub
    </a>
  </div>
</BaseLayout>

<script>
  import '../scripts/recipe-search';
</script>

<style>
  .search {
    position: relative;
    width: 100%;
  }

  .search input {
    width: 100%;
    height: 3.5rem;
    padding: 0.5rem 3.5rem;
    border: 0;
    border-bottom: 1px solid #aaa;
    border-radius: 0;
    background: white;
    color: var(--color-ink);
    font-size: 1.25rem;
    text-align: center;
  }

  .search-icon {
    position: absolute;
    top: 1.1rem;
    right: 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
    pointer-events: none;
  }

  .search-status {
    margin: 0;
    padding: 0.25rem 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-align: center;
  }

  .search-status:empty {
    display: none;
  }

  .recipes {
    padding: 0 0.75rem 0.75rem;
  }

  .recipe-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  .github-link-section {
    display: flex;
    justify-content: center;
    padding: 2.5rem 1rem 0;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 1rem;
    border: 2px solid var(--color-accent-dark);
    border-radius: 0.2rem;
    color: var(--color-accent-dark);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .github-link:hover {
    background: var(--color-accent-dark);
    color: white;
  }

  .github-link svg {
    width: 1.875rem;
    height: 1.875rem;
    fill: currentcolor;
  }

  @media (min-width: 40rem) {
    .recipe-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .recipe-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 90rem) {
    .recipe-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 112rem) {
    .recipe-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
