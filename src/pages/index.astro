---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getAllRecipeEntries, getListedRecipes } from '../lib/recipes/service';

const recipes = getListedRecipes(await getAllRecipeEntries());
---

<BaseLayout title="Malaubid" description="Malaubid, un site de recettes.">
  <section class="recipes" aria-labelledby="recipes-title">
    <h1 class="visually-hidden" id="recipes-title">Recettes</h1>
    <div class="recipe-grid">
      {
        recipes.map((recipe, index) => (
          <RecipeCard recipe={recipe} eager={index < 6} />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .recipes {
    padding: 0.75rem;
  }

  .recipe-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .recipe-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .recipe-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
