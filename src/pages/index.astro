---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getAllRecipeEntries, getListedRecipes } from '../lib/recipes/service';

const recipes = getListedRecipes(await getAllRecipeEntries());
---

<BaseLayout
  title="Malaubid"
  description="Des recettes familiales, des préparations utiles et des quantités qui s’adaptent à votre table."
>
  <section class="hero shell">
    <div>
      <p class="eyebrow">Carnet de cuisine</p>
      <h1>À table,<br /><em>simplement.</em></h1>
    </div>
    <div class="hero-copy">
      <p class="lede">
        Des recettes familiales, des préparations utiles et des quantités qui
        s’adaptent à votre table.
      </p>
      <a href="#toutes-les-recettes"
        >Voir les {recipes.length} recettes <span aria-hidden="true">↓</span></a
      >
    </div>
  </section>

  <section
    class="recipes shell"
    id="toutes-les-recettes"
    aria-labelledby="recipes-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">Le carnet</p>
        <h2 id="recipes-title">Toutes les recettes</h2>
      </div>
      <p>Classées par ordre alphabétique, prêtes à cuisiner.</p>
    </div>
    <div class="recipe-grid">
      {recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: min(42rem, 78vh);
    align-items: end;
    gap: clamp(2rem, 8vw, 8rem);
    grid-template-columns: minmax(0, 1.3fr) minmax(17rem, 0.7fr);
    padding-block: clamp(5rem, 12vw, 9rem) clamp(4rem, 9vw, 7rem);
  }

  h1 {
    margin: 0;
  }

  h1 em {
    color: var(--color-accent);
    font-weight: 500;
  }

  .hero-copy {
    padding-bottom: 0.8rem;
  }

  .hero-copy a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-weight: 800;
  }

  .recipes {
    scroll-margin-top: 2rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--color-line);
  }

  .section-heading h2,
  .section-heading p {
    margin-block: 0;
  }

  .section-heading > p {
    max-width: 24rem;
    color: var(--color-muted);
  }

  .recipe-grid {
    display: grid;
    gap: clamp(1.1rem, 2.5vw, 2rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 2.5rem;
  }

  @media (max-width: 54rem) {
    .hero {
      min-height: auto;
      align-items: start;
      grid-template-columns: 1fr;
    }

    .recipe-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .section-heading {
      align-items: start;
      flex-direction: column;
    }

    .recipe-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
