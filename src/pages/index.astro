---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { buildRecipeSearchText } from '../lib/recipes/search';
import {
  createRecipeIndex,
  getAllRecipeEntries,
  getListedRecipes,
  toRecipeSource,
} from '../lib/recipes/service';

const entries = await getAllRecipeEntries();
const recipes = getListedRecipes(entries);
const recipeIndex = createRecipeIndex(entries);
---

<BaseLayout title="Malaubid" description="Malaubid, un site de recettes.">
  <section class="search" role="search">
    <label class="visually-hidden" for="recipe-search">
      Rechercher une recette
    </label>
    <input
      id="recipe-search"
      data-recipe-search
      type="search"
      placeholder="Rechercher une recette"
      autocomplete="off"
      aria-controls="recipe-grid"
    />
    <svg class="search-icon" viewBox="0 0 32 32" aria-hidden="true">
      <path
        d="M12 0a12 12 0 1 0 6.5 22.1L28 32l4-4-9.9-9.5A12 12 0 0 0 12 0Zm0 4a8 8 0 1 1 0 16 8 8 0 0 1 0-16Z"
      ></path>
    </svg>
    <p class="search-status" data-search-status aria-live="polite"></p>
  </section>
  <section class="recipes" aria-labelledby="recipes-title">
    <h1 class="visually-hidden" id="recipes-title">Recettes</h1>
    <div class="recipe-grid" id="recipe-grid">
      {
        recipes.map((recipe, index) => (
          <RecipeCard
            recipe={recipe}
            searchText={buildRecipeSearchText(
              toRecipeSource(recipe),
              recipeIndex,
            )}
            eager={index < 6}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/recipe-search';
</script>

<style>
  .search {
    position: relative;
    width: 100%;
  }

  .search input {
    width: 100%;
    height: 3.5rem;
    padding: 0.5rem 3.5rem;
    border: 0;
    border-bottom: 1px solid #aaa;
    border-radius: 0;
    background: white;
    color: var(--color-ink);
    font-size: 1.25rem;
    text-align: center;
  }

  .search-icon {
    position: absolute;
    top: 1.1rem;
    right: 1.25rem;
    width: 1.25rem;
    height: 1.25rem;
    pointer-events: none;
  }

  .search-status {
    margin: 0;
    padding: 0.25rem 0;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-align: center;
  }

  .search-status:empty {
    display: none;
  }

  .recipes {
    padding: 0 0.75rem 0.75rem;
  }

  .recipe-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .recipe-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .recipe-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 90rem) {
    .recipe-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 112rem) {
    .recipe-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
